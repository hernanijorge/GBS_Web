@page "/invoices"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using GBS_Web.Data
@using Invoice = GBS_Web.Models.Invoice
@using InvoiceItem = GBS_Web.Models.InvoiceItem
@using Cliente = GBS_Web.Models.Cliente
@inject InvoiceRepository Repository
@inject ClienteRepository ClienteRepo
@inject EquipamentoRepository EquipRepo
@inject NavigationManager NavigationManager

<PageTitle>Invoices</PageTitle>

<h1>Invoices</h1>

<button class="btn btn-primary mb-3" @onclick="OpenNewModal">+ New Invoice</button>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_invoices.Count == 0)
{
    <p><em>No invoices found.</em></p>
}
else
{
    <div class="table-responsive d-none d-md-block">
    <table class="table table-striped table-hover">
        <thead>
            <tr><th>Number</th><th>Client</th><th>Issue Date</th><th>Due Date</th><th>Total (USD)</th><th>Created</th><th>Status</th><th>PDF</th></tr>
        </thead>
        <tbody>
            @foreach (var inv in _invoices)
            {
                <tr>
                    <td>@inv.InvoiceNumber</td>
                    <td>@inv.ClienteNome</td>
                    <td>@inv.IssueDate.ToString("yyyy-MM-dd")</td>
                    <td>@(inv.DueDate?.ToString("yyyy-MM-dd"))</td>
                    <td>@inv.TotalUsd.ToString("0.00")</td>
                    <td>@(inv.DataCadastro?.ToString("yyyy-MM-dd HH:mm"))</td>
                    <td style="width: 160px;">
                        <select class="form-select form-select-sm" value="@inv.StatusInvoice" @onchange="e => OnStatusChanged(inv, e)">
                            <option value="DRAFT">DRAFT</option>
                            <option value="SENT">SENT</option>
                            <option value="PAID">PAID</option>
                            <option value="CANCELLED">CANCELLED</option>
                        </select>
                    </td>
                    <td><a class="btn btn-sm btn-outline-secondary" href="@($"/invoices/{inv.IdInvoice}/pdf")" target="_blank">Download</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <div class="d-block d-md-none">
        @foreach (var inv in _invoices)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-bold">@inv.InvoiceNumber</div>
                            <div class="text-muted">$ @inv.TotalUsd.ToString("0.00")</div>
                        </div>
                        <span class="badge @InvoiceStatusBadgeClass(inv.StatusInvoice)">@inv.StatusInvoice</span>
                    </div>
                    <dl class="row row-cols-2 g-1 small mb-0 mt-2">
                        <dt class="col-6 text-muted fw-normal">Client</dt>
                        <dd class="col-6">@inv.ClienteNome</dd>
                        <dt class="col-6 text-muted fw-normal">Issue Date</dt>
                        <dd class="col-6">@inv.IssueDate.ToString("yyyy-MM-dd")</dd>
                        <dt class="col-6 text-muted fw-normal">Due Date</dt>
                        <dd class="col-6">@(inv.DueDate?.ToString("yyyy-MM-dd"))</dd>
                        <dt class="col-6 text-muted fw-normal">Created</dt>
                        <dd class="col-6">@(inv.DataCadastro?.ToString("yyyy-MM-dd HH:mm"))</dd>
                    </dl>
                    <div class="d-flex gap-2 mt-2 align-items-center">
                        <select class="form-select form-select-sm" style="width: auto;" value="@inv.StatusInvoice" @onchange="e => OnStatusChanged(inv, e)">
                            <option value="DRAFT">DRAFT</option>
                            <option value="SENT">SENT</option>
                            <option value="PAID">PAID</option>
                            <option value="CANCELLED">CANCELLED</option>
                        </select>
                        <a class="btn btn-sm btn-outline-secondary ms-auto" href="@($"/invoices/{inv.IdInvoice}/pdf")" target="_blank">Download</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_statusMessage is not null)
{
    <div class="alert @(_statusIsError ? "alert-danger" : "alert-success")">@_statusMessage</div>
}

@if (_showNewModal)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Invoice</h5>
                    <button type="button" class="btn-close" @onclick="CloseNewModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Client *</label>
                            <select class="form-select" @bind="_newInvoice.IdCliente">
                                <option value="0">-- select --</option>
                                @foreach (var c in _clients)
                                {
                                    <option value="@c.IdCliente">@c.NomeExibicao</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Issue Date</label>
                            <input class="form-control" type="date" @bind="_newInvoice.IssueDate" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Due Date</label>
                            <input class="form-control" type="date" @bind="_dueDate" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Client Email (override)</label>
                            <input class="form-control" @bind="_newInvoice.ClientEmail" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Discount (USD)</label>
                            <input class="form-control" type="number" step="0.01" @bind="_newInvoice.DiscountUsd" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Shipping (USD)</label>
                            <input class="form-control" type="number" step="0.01" @bind="_newInvoice.ShippingUsd" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Tax (USD)</label>
                            <input class="form-control" type="number" step="0.01" @bind="_newInvoice.TaxUsd" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <input class="form-control" @bind="_newInvoice.Notes" />
                    </div>

                    <hr />
                    <h6>Line items</h6>
                    <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr><th>Description</th><th>Equipment UID (optional)</th><th>Qty</th><th>Unit (USD)</th><th>Line Total</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td><input class="form-control form-control-sm" @bind="item.Description" /></td>
                                    <td><input class="form-control form-control-sm" @bind="item.InternalUid" /></td>
                                    <td><input class="form-control form-control-sm" type="number" step="0.01" @bind="item.Qty" /></td>
                                    <td><input class="form-control form-control-sm" type="number" step="0.01" @bind="item.UnitPriceUsd" /></td>
                                    <td class="align-middle">@((item.Qty * item.UnitPriceUsd).ToString("0.00"))</td>
                                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveItem(item)">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddItem">+ Add Line</button>

                    @if (!string.IsNullOrEmpty(_validationError))
                    {
                        <div class="alert alert-warning mt-3">@_validationError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseNewModal">Cancel</button>
                    <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="SaveAsync">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Invoice> _invoices = new();
    private List<Cliente> _clients = new();
    private bool _loading = true;
    private bool _showNewModal;
    private bool _saving;
    private string? _validationError;
    private string? _statusMessage;
    private bool _statusIsError;

    private Invoice _newInvoice = new();
    private DateTime? _dueDate;
    private List<InvoiceItem> _items = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _invoices = await Repository.GetAllAsync();
        _loading = false;
    }

    private async Task OpenNewModal()
    {
        _newInvoice = new Invoice();
        _dueDate = null;
        _items = new() { new InvoiceItem { Qty = 1 } };
        _validationError = null;
        _clients = await ClienteRepo.SearchAsync(null);
        _showNewModal = true;
    }

    private void CloseNewModal() => _showNewModal = false;

    private void AddItem() => _items.Add(new InvoiceItem { Qty = 1 });

    private void RemoveItem(InvoiceItem item) => _items.Remove(item);

    private async Task SaveAsync()
    {
        _validationError = null;

        if (_newInvoice.IdCliente <= 0)
        {
            _validationError = "Select a client.";
            return;
        }

        var validItems = _items.Where(i => !string.IsNullOrWhiteSpace(i.Description)).ToList();
        if (validItems.Count == 0)
        {
            _validationError = "Add at least one line item.";
            return;
        }

        _saving = true;
        try
        {
            _newInvoice.DueDate = _dueDate;

            foreach (var item in validItems)
            {
                if (!string.IsNullOrWhiteSpace(item.InternalUid))
                {
                    var matches = await EquipRepo.GetAllAsync(item.InternalUid.Trim(), null);
                    var exact = matches.FirstOrDefault(e => string.Equals(e.InternalUid, item.InternalUid.Trim(), StringComparison.OrdinalIgnoreCase));
                    item.IdEquipamento = exact?.IdEquipamento;
                }
            }

            var (idInvoice, invoiceNumber) = await Repository.CreateWithItemsAsync(_newInvoice, validItems);
            _showNewModal = false;
            _statusMessage = $"Invoice {invoiceNumber} created (#{idInvoice}).";
            _statusIsError = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _validationError = $"Error creating invoice: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnStatusChanged(Invoice inv, ChangeEventArgs e)
    {
        var newStatus = e.Value?.ToString() ?? inv.StatusInvoice;
        if (newStatus == inv.StatusInvoice) return;

        try
        {
            await Repository.UpdateStatusAsync(inv.IdInvoice, newStatus);
            inv.StatusInvoice = newStatus;
            _statusMessage = $"{inv.InvoiceNumber} status updated to {newStatus}.";
            _statusIsError = false;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error updating status: {ex.Message}";
            _statusIsError = true;
        }
    }

    private static string InvoiceStatusBadgeClass(string status) => status switch
    {
        "PAID" => "bg-success",
        "SENT" => "bg-primary",
        "CANCELLED" => "bg-danger",
        _ => "bg-secondary"
    };
}
